  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.148",
    "ai-sdk-ollama": "^4.5.1",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
